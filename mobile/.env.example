# Copy to .env (git-ignored) and set the backend address the app talks to.
# The app adds /api/v1 itself.
#
#   Real phone, same Wi-Fi as your Mac:  http://<Mac Wi-Fi IP>:8000   e.g. http://192.168.1.25:8000
#                                        (start Laravel with: php artisan serve --host=0.0.0.0 --port=8000)
#   Android emulator:                    http://10.0.2.2:8000
#   iOS simulator / web:                 http://localhost:8000
#   Store builds:                        https://<your Laravel Cloud API domain>
EXPO_PUBLIC_API_URL=http://192.168.1.25:8000
