# Static analysis: finds typos, wrong types and missing methods without running the code.
# Run: ./vendor/bin/phpstan analyse   (CI runs it on every push)
# Existing findings live in phpstan-baseline.neon; new code must be clean.
# Shrink the baseline over time: fix an entry, then  ./vendor/bin/phpstan analyse --generate-baseline
includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - app
        - routes
        - bootstrap/app.php
    tmpDir: storage/framework/phpstan
